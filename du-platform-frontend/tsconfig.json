{
  "extends": "../tsconfig.json",
  "include": ["src/**/*", "../shared/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx"],
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/typescript/du-platform-frontend.tsbuildinfo",
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../shared/*"]
    }
  }
}
