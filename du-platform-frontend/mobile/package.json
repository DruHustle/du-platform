{
  "name": "diaspora-unlocked-mobile",
  "description": "Native Diaspora Unlocked application for iOS and Android",
  "license": "0BSD",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "~58.0.22",
    "expo-build-properties": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build": "expo export --platform android --output-dir dist/android && expo export --platform ios --output-dir dist/ios",
    "lint": "tsc --noEmit",
    "native:generate": "expo prebuild --clean --no-install --template expo-template-bare-minimum@58.0.31"
  },
  "private": true,
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "overrides": {
    "@expo/cli@58.1.18": {
      "glob": "14.0.4"
    },
    "@expo/fingerprint@0.21.9": {
      "glob": "14.0.4",
      "minimatch": "11.0.5"
    },
    "@expo/metro-config@58.0.20": {
      "glob": "14.0.4"
    }
  }
}
