# The browser uses the same-origin /api route in production.
VITE_API_URL=/api
BACKEND_URL=http://localhost:5001
VITE_DEV_HTTPS=false
VITE_SITE_URL=https://www.diasporaunlocked.com

# Set each only after its public release listing or TestFlight invitation works.
VITE_IOS_DOWNLOAD_URL=
VITE_ANDROID_DOWNLOAD_URL=

# SHA-256 of the published, owner-signed Android APK (direct APK downloads only).
VITE_ANDROID_APK_SHA256=
