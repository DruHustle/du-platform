{
  "name": "@du/frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && node --import tsx scripts/build-route-documents.mjs && pnpm check:deployment-size",
    "preview": "vite preview --host",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run && node --test scripts/tests/*.test.mjs",
    "test:seo": "node --import tsx scripts/tests/seo-build.mjs",
    "test:seo:live": "node scripts/tests/seo-live.mjs",
    "check:deployment-size": "node scripts/check-deployment-size.mjs",
    "sitemap:generate": "node --import tsx scripts/generate-sitemap.mjs",
    "translations:sync": "python3 scripts/sync_translations.py --mode sync",
    "translations:sync:todo": "python3 scripts/sync_translations.py --mode sync --mark-missing",
    "translations:check:keys": "python3 scripts/sync_translations.py --mode check",
    "translations:check": "python3 scripts/sync_translations.py --mode check --require-translated --allow-same-keys-file scripts/translation_allow_same_keys.txt",
    "guardrails:vite": "node scripts/guardrails/check-vite-guardrails.mjs",
    "guardrails:locales": "node scripts/guardrails/check-locales-shape.mjs"
  },
  "dependencies": {
    "@du/shared": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/xr": "^6.6.29",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.22",
    "i18next": "^25.8.4",
    "lucide-react": "^0.453.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-globe.gl": "^2.37.0",
    "react-i18next": "^16.5.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "three": "^0.183.1",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@builder.io/vite-plugin-jsx-loc": "^0.1.1",
    "@tailwindcss/vite": "^4.1.3",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "terser": "^5.46.0",
    "tsx": "^4.19.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.6.3",
    "vite": "^7.1.7",
    "vite-plugin-html": "^3.2.2",
    "vitest": "^2.1.4"
  }
}
