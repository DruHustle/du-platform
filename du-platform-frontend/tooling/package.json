{
  "name": "du-platform",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cd ../.. && ./du-platform-frontend/tooling/scripts/dev-all.sh",
    "dev:fast": "cd ../.. && ./du-platform-frontend/tooling/scripts/dev-all.sh --fast",
    "dev:web": "cd ../.. && pnpm --dir du-platform-frontend/web dev",
    "dev:server": "cd ../.. && pnpm --dir du-platform-backend dev",
    "dev:all": "cd ../.. && ./du-platform-frontend/tooling/scripts/dev-all.sh",
    "prepare": "node -e \"console.log('Install repository hooks explicitly with pnpm hooks:install')\"",
    "hooks:install": "git config core.hooksPath du-platform-frontend/tooling/githooks && chmod +x githooks/pre-commit",
    "build": "cd ../.. && pnpm --dir du-platform-frontend/tooling build:frontend && pnpm --dir du-platform-frontend/tooling build:backend",
    "start": "cd ../.. && pnpm --dir du-platform-backend start",
    "preview": "cd ../.. && pnpm --dir du-platform-frontend/web preview",
    "check": "cd ../.. && pnpm --dir du-platform-frontend/tooling check:frontend && pnpm --dir du-platform-frontend/tooling check:backend",
    "guardrails:vite": "cd ../.. && node du-platform-frontend/tooling/scripts/guardrails/check-vite-guardrails.mjs",
    "guardrails:deploy": "cd ../.. && node du-platform-frontend/tooling/scripts/guardrails/check-deploy-guardrails.mjs",
    "guardrails:locales": "cd ../.. && node du-platform-frontend/tooling/scripts/guardrails/check-locales-shape.mjs",
    "guardrails": "cd ../.. && pnpm --dir du-platform-frontend/tooling guardrails:vite && pnpm --dir du-platform-frontend/tooling guardrails:deploy && pnpm --dir du-platform-frontend/tooling guardrails:locales",
    "sitemap:generate": "cd ../.. && pnpm --dir du-platform-frontend/web sitemap",
    "test:e2e:onesa": "cd ../.. && bash du-platform-frontend/tooling/scripts/tests/e2e-onesa.sh",
    "test:e2e:onesa:bubble": "cd ../.. && node du-platform-frontend/tooling/scripts/tests/e2e-onesa-bubble-recover.mjs",
    "test:e2e:onesa:chat": "cd ../.. && node du-platform-frontend/tooling/scripts/tests/e2e-onesa-chat.mjs",
    "test:e2e:onesa:runtime": "cd ../.. && node --import ./du-platform-frontend/tooling/node_modules/tsx/dist/loader.mjs du-platform-frontend/tooling/scripts/tests/e2e-onesa-runtime.mjs",
    "test:modules": "cd ../.. && pnpm --dir du-platform-backend test",
    "format": "cd ../.. && prettier --ignore-path du-platform-frontend/tooling/.prettierignore --write .",
    "translations:sync": "cd ../.. && python3 du-platform-frontend/tooling/scripts/sync_translations.py --mode sync",
    "translations:sync:todo": "cd ../.. && python3 du-platform-frontend/tooling/scripts/sync_translations.py --mode sync --mark-missing",
    "translations:check:keys": "cd ../.. && python3 du-platform-frontend/tooling/scripts/sync_translations.py --mode check",
    "translations:check": "cd ../.. && python3 du-platform-frontend/tooling/scripts/sync_translations.py --mode check --require-translated --allow-same-keys-file du-platform-frontend/tooling/scripts/translation_allow_same_keys.txt",
    "build:frontend": "cd ../.. && pnpm --dir du-platform-frontend/web build",
    "build:backend": "cd ../.. && pnpm --dir du-platform-backend build",
    "docker:build": "cd ../.. && python3 du-platform-backend/deploy/oracle/manage-images.py build-local",
    "docker:cleanup": "cd ../.. && python3 du-platform-backend/deploy/oracle/manage-images.py cleanup",
    "check:frontend": "cd ../.. && pnpm --dir du-platform-frontend/web check",
    "check:backend": "cd ../.. && pnpm --dir du-platform-backend check",
    "format:check": "cd ../.. && prettier --ignore-path du-platform-frontend/tooling/.prettierignore --check .",
    "test:frontend": "cd ../.. && pnpm --dir du-platform-frontend/web test && node --test du-platform-frontend/tooling/scripts/tests/frontend-api-origin.test.mjs du-platform-frontend/tooling/scripts/tests/deployment-size.test.mjs",
    "check:deployment-size": "cd ../.. && pnpm --dir du-platform-frontend/web exec node scripts/check-deployment-size.mjs",
    "test": "cd ../.. && pnpm --dir du-platform-frontend/tooling test:modules && pnpm --dir du-platform-frontend/tooling test:frontend",
    "test:seo": "cd ../.. && pnpm --dir du-platform-frontend/web exec node --import tsx ../tooling/scripts/tests/seo-build.mjs",
    "test:seo:live": "cd ../.. && node du-platform-frontend/tooling/scripts/tests/seo-live.mjs",
    "test:e2e:offline": "cd ../.. && node du-platform-frontend/tooling/scripts/tests/e2e-offline-services.mjs",
    "test:e2e:navigation": "cd ../.. && node du-platform-frontend/tooling/scripts/tests/e2e-navigation.mjs",
    "test:e2e:shop": "cd ../.. && node --import ./du-platform-frontend/tooling/node_modules/tsx/dist/loader.mjs du-platform-frontend/tooling/scripts/tests/e2e-shop.mjs",
    "test:e2e:newsletter": "cd ../.. && node du-platform-frontend/tooling/scripts/tests/e2e-newsletter.mjs",
    "test:e2e:transactional": "cd ../.. && node --import ./du-platform-frontend/tooling/node_modules/tsx/dist/loader.mjs du-platform-frontend/tooling/scripts/tests/e2e-transactional.mjs",
    "test:e2e:discovery": "cd ../.. && node du-platform-frontend/tooling/scripts/tests/e2e-discovery.mjs",
    "test:e2e:vr:music": "cd ../.. && node du-platform-frontend/tooling/scripts/tests/e2e-vr-music.mjs",
    "test:e2e:shop:integrated": "cd ../.. && node --import ./du-platform-frontend/tooling/node_modules/tsx/dist/loader.mjs du-platform-frontend/tooling/scripts/tests/e2e-shop-integrated.mjs",
    "test:deploy": "cd ../.. && node --test du-platform-frontend/tooling/scripts/tests/oracle-deploy.test.mjs && PYTHONDONTWRITEBYTECODE=1 python3 du-platform-frontend/tooling/scripts/tests/docker-images.test.py && PYTHONDONTWRITEBYTECODE=1 python3 du-platform-frontend/tooling/scripts/tests/oracle-release-worker.test.py && node --test du-platform-frontend/tooling/scripts/tests/pilot-deploy.test.mjs du-platform-frontend/tooling/scripts/tests/vercel-release.test.mjs",
    "test:e2e:shop:admin": "cd ../.. && node du-platform-frontend/tooling/scripts/tests/e2e-shop-admin.mjs",
    "test:e2e:pilot": "cd ../.. && node du-platform-frontend/tooling/scripts/tests/e2e-pilot.mjs",
    "test:e2e:pilot:layout": "cd ../.. && node --import ./du-platform-frontend/tooling/node_modules/tsx/dist/loader.mjs du-platform-frontend/tooling/scripts/tests/e2e-pilot-layout.mjs",
    "test:e2e:prelaunch": "cd ../.. && node --import ./du-platform-frontend/tooling/node_modules/tsx/dist/loader.mjs du-platform-frontend/tooling/scripts/tests/e2e-prelaunch.mjs",
    "test:recovery:custody": "cd ../.. && node du-platform-frontend/tooling/scripts/tests/recovery-custody.mjs",
    "test:recovery:application": "cd ../.. && node du-platform-frontend/tooling/scripts/tests/restored-application.mjs",
    "test:e2e:shop:followup": "cd ../.. && node --import ./du-platform-frontend/tooling/node_modules/tsx/dist/loader.mjs du-platform-frontend/tooling/scripts/tests/e2e-shop-followup.mjs",
    "test:backup:mac": "cd ../.. && PYTHONDONTWRITEBYTECODE=1 python3 du-platform-frontend/tooling/scripts/tests/mac-backup-pull.test.py",
    "test:e2e:ui": "cd ../.. && node --import ./du-platform-frontend/tooling/node_modules/tsx/dist/loader.mjs du-platform-frontend/tooling/scripts/tests/e2e-ui-consistency.mjs",
    "test:e2e:travel": "cd ../.. && node --import ./du-platform-frontend/tooling/node_modules/tsx/dist/loader.mjs du-platform-frontend/tooling/scripts/tests/e2e-travel.mjs",
    "test:e2e:theme": "cd ../.. && node --import ./du-platform-frontend/tooling/node_modules/tsx/dist/loader.mjs du-platform-frontend/tooling/scripts/tests/e2e-theme.mjs",
    "test:e2e:weather": "cd ../.. && node --import ./du-platform-frontend/tooling/node_modules/tsx/dist/loader.mjs du-platform-frontend/tooling/scripts/tests/e2e-weather.mjs",
    "check:architecture": "cd ../.. && node du-platform-frontend/tooling/scripts/check-architecture.mjs",
    "test:isolation": "cd ../.. && node du-platform-frontend/tooling/scripts/test-isolation.mjs"
  },
