# Diaspora Unlocked Platform - Example Environment (Render & Aiven MySQL)

NODE_ENV=development
VITE_API_URL=/api
BACKEND_URL=http://localhost:5001
FRONTEND_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:5001
# Development backend port
DEV_PORT=5001
# Test backend port
TEST_PORT=5002
# Runtime port (for local dev defaults). In production, hosting usually injects PORT.
PORT=5001
# Optional explicit production fallback if PORT is not injected
# PROD_PORT=3000
# In development this server binds strictly to DEV_PORT (or PORT if DEV_PORT is unset).
# Set to true only if you want automatic port hopping when PORT is busy.
# ALLOW_PORT_FALLBACK=false
DEBUG=true
# Set to true on Render/Heroku/Fly so Express trusts X-Forwarded-For for real client IPs.
# Required for correct IP-based geo detection and rate limiting behind a reverse proxy.
# TRUST_PROXY=true

# Development / Test (local MySQL only)
# DATABASE_URL=mysql://root:password@127.0.0.1:3306/du_platform
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=password
# MYSQL_DATABASE=du_platform

# Production (Aiven only)
# AIVEN_MYSQL_URL=mysql://USER:PASSWORD@HOST:PORT/DATABASE
# AIVEN_MYSQL_HOST=your-host.aivencloud.com
# AIVEN_MYSQL_PORT=12345
# AIVEN_MYSQL_USER=avnadmin
# AIVEN_MYSQL_PASSWORD=your_password
# AIVEN_MYSQL_DATABASE=defaultdb
# AIVEN_CA_CERT=-----BEGIN CERTIFICATE-----...-----END CERTIFICATE-----
# AIVEN_CA_CERT_PATH=./certs/aiven-ca.pem

# Password reset email settings (Resend)
RESET_EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxx
FROM_EMAIL=no-reply@yourdomain.com
APP_BASE_URL=http://localhost:3000
# Notify email defaults:
# - Initial Admin alert recipients fallback to ADMIN_EMAILS
# - Initial notify sender fallback to FROM_EMAIL
# Both can later be changed in Admin Dashboard > Notify Me > Notification Email Settings

# Production override reference (Frontend: Vercel, Backend: Render, DNS: Squarespace)
# NODE_ENV=production
# APP_BASE_URL=https://your-app-domain.com
# FRONTEND_PUBLIC_URL=https://your-app-domain.com
# API_PUBLIC_URL=https://api.your-app-domain.com
# BACKEND_URL=https://api.your-app-domain.com
# VITE_API_URL=https://api.your-app-domain.com/api
# FROM_EMAIL=no-reply@your-app-domain.com
# ADMIN_EMAILS=ops@your-app-domain.com,alerts@your-app-domain.com

# Onesa AI endpoint
# Provider options: ollama | openai_compatible
ONESA_PROVIDER=openai_compatible
ONESA_MODEL=gemini-2.5-flash
ONESA_FALLBACK_MODEL=gemini-2.0-flash
# Optional model failover chain for PRIMARY cloud provider (comma-separated, tried in order)
# ONESA_MODEL_CANDIDATES=gemini-2.5-flash,gemini-2.0-flash
# Optional SECONDARY cloud provider failover (example: Groq)
# ONESA_GROK_AI_BASE_URL=https://api.groq.com/openai/v1
# ONESA_GROK_AI_API_KEY=YOUR_GROQ_API_KEY
# ONESA_GROK_MODEL=llama-3.3-70b-versatile
# ONESA_GROK_FALLBACK_MODEL=llama-3.1-8b-instant
# ONESA_GROK_MODEL_CANDIDATES=llama-3.3-70b-versatile,meta-llama/llama-4-scout-17b-16e-instruct
# Optional TERTIARY cloud provider failover (example: OpenRouter)
# ONESA_TERTIARY_AI_BASE_URL=https://openrouter.ai/api/v1
# ONESA_TERTIARY_AI_API_KEY=YOUR_OPENROUTER_API_KEY
# ONESA_TERTIARY_MODEL=meta-llama/llama-3.1-70b-instruct
# ONESA_TERTIARY_FALLBACK_MODEL=meta-llama/llama-3.1-8b-instruct
# ONESA_TERTIARY_MODEL_CANDIDATES=meta-llama/llama-3.1-70b-instruct,meta-llama/llama-3.1-8b-instruct
# Optional Claude (Anthropic) fallback
# ONESA_CLAUDE_API_KEY=YOUR_ANTHROPIC_API_KEY
# ONESA_CLAUDE_BASE_URL=https://api.anthropic.com
# ONESA_CLAUDE_MODEL=claude-3-5-sonnet-latest
# ONESA_CLAUDE_FALLBACK_MODEL=claude-3-5-haiku-latest
# ONESA_CLAUDE_MODEL_CANDIDATES=claude-3-5-sonnet-latest,claude-3-5-haiku-latest
# ONESA_CLAUDE_ANTHROPIC_VERSION=2023-06-01
# Optional Cerebras fallback
# ONESA_CEREBRAS_API_KEY=YOUR_CEREBRAS_API_KEY
# ONESA_CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# ONESA_CEREBRAS_MODEL=llama-3.3-70b
# ONESA_CEREBRAS_FALLBACK_MODEL=llama-3.1-8b
# ONESA_CEREBRAS_MODEL_CANDIDATES=llama-3.3-70b,llama-3.1-8b
ONESA_REQUEST_TIMEOUT_MS=180000
ONESA_MAX_TOKENS=220

# For ONESA_PROVIDER=ollama
# ONESA_OLLAMA_URL=http://127.0.0.1:11434

# For ONESA_PROVIDER=openai_compatible
# ONESA_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# ONESA_AI_API_KEY=YOUR_GEMINI_API_KEY
# Gemini native TTS route (used by /api/tts and /api/speech action=tts)
# ONESA_GEMINI_TTS_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# ONESA_GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# ONESA_GEMINI_TTS_RESPONSE_FORMAT=wav

# Optional system instruction override
# ONESA_SYSTEM_PROMPT=You are Onesa AI...

# Comma-separated admin emails (required for /admin access)
# ADMIN_EMAILS=admin@example.com,owner@example.com

# Financial APIs (server-side only)
# JWT secret for remittance/airtime protected endpoints
JWT_SECRET=replace_with_long_random_secret
# JWT access token TTL in seconds
JWT_EXPIRES_IN_SECONDS=3600
# Enable mock provider responses for end-to-end local testing
FINANCIAL_SANDBOX_MOCK=false

# Thunes (Money Transfer API)
# Base URL is provided by Thunes. Must include the /v2/money-transfer path.
THUNES_BASE_URL=https://api-mt.preprod.thunes.com/v2/money-transfer
THUNES_API_KEY=
THUNES_API_SECRET=
# Fallback payer ID (used when no type- or channel-specific ID is set)
THUNES_PAYER_ID=
# Per-type payer IDs (override the fallback for each delivery method)
# THUNES_PAYER_ID_MOBILE_MONEY=    # e.g. EcoCash Zimbabwe
# THUNES_PAYER_ID_VISA_CARD=       # e.g. Visa card disbursement
# THUNES_PAYER_ID_CASH_PICKUP=             # cash pickup (single payer for all agents)
# Per-bank payer IDs for bank transfers (most specific — override THUNES_PAYER_ID_BANK)
# THUNES_PAYER_ID_BANK=                    # generic bank transfer fallback
# THUNES_PAYER_ID_BANK_ZB_BANK=
# THUNES_PAYER_ID_BANK_CBZ=
# THUNES_PAYER_ID_BANK_BANCABC=
# THUNES_PAYER_ID_BANK_STEWARD_BANK=
# Optional: override transaction type (C2C, C2B, B2C, B2B)
# THUNES_TRANSACTION_TYPE=C2C
# Optional callback URL for transaction status webhooks
# THUNES_CALLBACK_URL=https://example.com/api/fintech/remittance/webhook
# Optional statement description sent with transactions
# THUNES_STATEMENT_DESCRIPTION=Diaspora Unlocked Remittance
# Default origin country (ISO 3166-1 alpha-2 or alpha-3)
THUNES_ORIGIN_COUNTRY=DE
# Optional default receiving country (ISO 3166-1 alpha-2 or alpha-3)
THUNES_RECEIVING_COUNTRY=ZW
# Default sender MSISDN (sender's number) used when the request does not provide one.
THUNES_SENDER_MSISDN=
# Optional fallback sender MSISDN if THUNES_SENDER_MSISDN is not set.
THUNES_DEFAULT_MSISDN=
# Sender details required by many payers
THUNES_SENDER_DATE_OF_BIRTH=1985-01-15
THUNES_SENDER_FIRSTNAME=
THUNES_SENDER_LASTNAME=
THUNES_SENDER_EMAIL=
THUNES_SENDER_COUNTRY_ISO3=DEU
THUNES_SENDER_NATIONALITY_ISO3=DEU
THUNES_SENDER_COUNTRY_OF_BIRTH_ISO3=DEU
THUNES_SENDER_ADDRESS=
THUNES_SENDER_CITY=
THUNES_SENDER_POSTAL_CODE=
THUNES_SENDER_GENDER=
THUNES_SENDER_ID_TYPE=
THUNES_SENDER_ID_NUMBER=
THUNES_SENDER_ID_COUNTRY_ISO3=
# Optional beneficiary defaults
THUNES_BENEFICIARY_FIRSTNAME=
THUNES_BENEFICIARY_LASTNAME=
THUNES_BENEFICIARY_DATE_OF_BIRTH=
THUNES_BENEFICIARY_EMAIL=
THUNES_BENEFICIARY_COUNTRY_ISO3=ZWE
THUNES_BENEFICIARY_NATIONALITY_ISO3=ZWE
THUNES_BENEFICIARY_COUNTRY_OF_BIRTH_ISO3=ZWE
THUNES_BENEFICIARY_ADDRESS=
THUNES_BENEFICIARY_CITY=
THUNES_BENEFICIARY_POSTAL_CODE=

# Reloadly (Sandbox)
# These are OAuth credentials from Reloadly, not a generic public API token.
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
RELOADLY_BASE_URL=https://topups-sandbox.reloadly.com
RELOADLY_UTILITIES_BASE_URL=https://utilities-sandbox.reloadly.com
# RELOADLY_AUTH_URL=https://auth.reloadly.com
# Optional overrides. If omitted, audiences are derived from the configured base URLs.
# Sandbox defaults:
# RELOADLY_AUDIENCE=https://topups-sandbox.reloadly.com
# RELOADLY_UTILITIES_AUDIENCE=https://utilities-sandbox.reloadly.com
# Production examples:
# RELOADLY_AUDIENCE=https://topups.reloadly.com
# RELOADLY_UTILITIES_AUDIENCE=https://utilities.reloadly.com
