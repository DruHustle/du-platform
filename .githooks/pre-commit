#!/usr/bin/env bash
set -euo pipefail

PUBLIC_DIR="du-platform-frontend/public"

EN_FILE="$PUBLIC_DIR/locales/en/translation.json"
if git diff --cached --name-only | grep -qx "$EN_FILE"; then
  echo "[pre-commit] English translations changed. Syncing locale keys..."
  python3 scripts/sync_translations.py --mode sync
  pnpm exec prettier --write "$PUBLIC_DIR"/locales/*/translation.json
  git add "$PUBLIC_DIR"/locales/*/translation.json
else
  echo "[pre-commit] No English translation key changes detected. Skipping translation sync."
fi

echo "[pre-commit] Generating sitemap..."
node --import tsx scripts/generate-sitemap.mjs

echo "[pre-commit] Staging generated files..."
git add "$PUBLIC_DIR/sitemap.xml"

echo "[pre-commit] Done."
