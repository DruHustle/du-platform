# Optional isolated candidate. Does not change the app's current primary.
DU_MYSQL_IMAGE=mysql:<source-compatible-version>@sha256:<reviewed-image-digest>
DU_MYSQL_PLATFORM=<qualified-linux-platform>
DU_MYSQL_UID=<mysql-uid-from-reviewed-image>
DU_MYSQL_GID=<mysql-gid-from-reviewed-image>
DU_MYSQL_MEMORY_LIMIT=<capacity-qualified-memory-limit>
DU_MYSQL_CPU_LIMIT=<capacity-qualified-cpu-limit>
DU_MYSQL_BUFFER_POOL_SIZE=<measured-buffer-pool-size-below-memory-limit>
DU_MYSQL_MAX_CONNECTIONS=<capacity-qualified-connection-limit>
DU_MYSQL_VOLUME=<existing-reviewed-durable-volume-name>
DU_MYSQL_PASSWORD_FILE=<absolute-private-bootstrap-password-file>
DU_MYSQL_TLS_DIR=<absolute-private-directory-with-ca.crt-server.crt-server.key>
# Used only by the optional application CA/network overlay.
DU_DATABASE_CA_FILE=<absolute-public-ca-certificate-file>
