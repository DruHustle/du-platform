# DB fields for an isolated qualification app, not a complete runtime env file.
# Keep production on its current AIVEN_* settings until a reviewed cutover.
NODE_ENV=production
DATABASE_PROVIDER=mysql
DATABASE_URL=mysql://<du-application-user>:<url-encoded-secret>@du-mysql:3306/<restored-du-database>
MYSQL_CA_CERT_PATH=/run/du-db-ca/root.crt
# Preserve JWT_SECRET and the remaining approved configuration in the private runtime.
# Current startup uses this same DB connection for additive schema/seed work.
