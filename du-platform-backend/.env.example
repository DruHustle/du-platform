# Diaspora Unlocked Platform - Example Environment (Oracle & Aiven MySQL)

NODE_ENV=development
FRONTEND_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:5001
# Development backend port
DEV_PORT=5001
# Test backend port
TEST_PORT=5002
# Runtime port (for local dev defaults). In production, hosting usually injects PORT.
PORT=5001
# Optional explicit production fallback if PORT is not injected
# PROD_PORT=3000
# In development this server binds strictly to DEV_PORT (or PORT if DEV_PORT is unset).
# Set to true only if you want automatic port hopping when PORT is busy.
# ALLOW_PORT_FALLBACK=false
DEBUG=true
# Set to true behind Oracle's Caddy proxy so Express trusts X-Forwarded-For for real client IPs.
# Required for correct IP-based geo detection and rate limiting behind a reverse proxy.
# TRUST_PROXY=true
# Comma-separated list of allowed CORS origins (scheme+host only, e.g. https://app.example.com)
# Defaults to localhost:3000 in development. Required in production.
# CORS_ORIGINS=https://app.example.com,https://www.example.com
# CSRF protection: defaults to enabled in production, disabled in development.
# Override with CSRF_ENABLED=true|false.
# CSRF_ENABLED=true

# Development / Test (local MySQL only)
# DATABASE_URL=mysql://root:password@127.0.0.1:3306/du_platform
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=password
# MYSQL_DATABASE=du_platform

# Production (Aiven only)
# AIVEN_MYSQL_URL=mysql://USER:PASSWORD@HOST:PORT/DATABASE
# AIVEN_MYSQL_HOST=your-host.aivencloud.com
# AIVEN_MYSQL_PORT=12345
# AIVEN_MYSQL_USER=avnadmin
# AIVEN_MYSQL_PASSWORD=your_password
# AIVEN_MYSQL_DATABASE=defaultdb
# AIVEN_CA_CERT=-----BEGIN CERTIFICATE-----...-----END CERTIFICATE-----
# AIVEN_CA_CERT_PATH=./certs/aiven-ca.pem

# Password reset email settings (Resend)
RESET_EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxx
FROM_EMAIL=no-reply@yourdomain.com
APP_BASE_URL=http://localhost:3000
# Notify email defaults:
# - Initial Admin alert recipients fallback to ADMIN_EMAILS
# - Initial notify sender fallback to FROM_EMAIL
# Both can later be changed in Admin Dashboard > Notify Me > Notification Email Settings

# Production override reference (Frontend: Vercel, Backend: Oracle, DNS: Squarespace)
# NODE_ENV=production
# APP_BASE_URL=https://your-app-domain.com
# FRONTEND_PUBLIC_URL=https://your-app-domain.com
# API_PUBLIC_URL=https://api.your-app-domain.com
# BACKEND_URL=https://api.your-app-domain.com
# VITE_API_URL=/api
# APP_REVISION=<tested-source-commit>
# FROM_EMAIL=no-reply@your-app-domain.com
# ADMIN_EMAILS=ops@your-app-domain.com,alerts@your-app-domain.com

# Onesa AI endpoint
# Provider options: ollama | openai_compatible
ONESA_PROVIDER=openai_compatible
ONESA_MODEL=gemini-2.5-flash
ONESA_FALLBACK_MODEL=gemini-2.0-flash
# Optional model failover chain for PRIMARY cloud provider (comma-separated, tried in order)
# ONESA_MODEL_CANDIDATES=gemini-2.5-flash,gemini-2.0-flash
# Optional SECONDARY cloud provider failover (example: Groq)
# ONESA_GROQ_AI_BASE_URL=https://api.groq.com/openai/v1
# ONESA_GROQ_AI_API_KEY=YOUR_GROQ_API_KEY
# Choose currently available chat models from your provider's /models endpoint.
# ONESA_GROQ_MODEL=<current-primary-chat-model>
# ONESA_GROQ_FALLBACK_MODEL=<current-fallback-chat-model>
# ONESA_GROQ_MODEL_CANDIDATES=<current-primary-chat-model>,<current-fallback-chat-model>
# Legacy ONESA_GROK_* names are also accepted; ONESA_GROQ_* takes precedence.
# Optional TERTIARY cloud provider failover (example: OpenRouter)
# ONESA_TERTIARY_AI_BASE_URL=https://openrouter.ai/api/v1
# ONESA_TERTIARY_AI_API_KEY=YOUR_OPENROUTER_API_KEY
# ONESA_TERTIARY_MODEL=meta-llama/llama-3.1-70b-instruct
# ONESA_TERTIARY_FALLBACK_MODEL=meta-llama/llama-3.1-8b-instruct
# ONESA_TERTIARY_MODEL_CANDIDATES=meta-llama/llama-3.1-70b-instruct,meta-llama/llama-3.1-8b-instruct
# Optional Claude (Anthropic) fallback
# ONESA_CLAUDE_API_KEY=YOUR_ANTHROPIC_API_KEY
# ONESA_CLAUDE_BASE_URL=https://api.anthropic.com
# ONESA_CLAUDE_MODEL=claude-3-5-sonnet-latest
# ONESA_CLAUDE_FALLBACK_MODEL=claude-3-5-haiku-latest
# ONESA_CLAUDE_MODEL_CANDIDATES=claude-3-5-sonnet-latest,claude-3-5-haiku-latest
# ONESA_CLAUDE_ANTHROPIC_VERSION=2023-06-01
# Optional Cerebras fallback
# ONESA_CEREBRAS_API_KEY=YOUR_CEREBRAS_API_KEY
# ONESA_CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# ONESA_CEREBRAS_MODEL=llama-3.3-70b
# ONESA_CEREBRAS_FALLBACK_MODEL=llama-3.1-8b
# ONESA_CEREBRAS_MODEL_CANDIDATES=llama-3.3-70b,llama-3.1-8b
ONESA_REQUEST_TIMEOUT_MS=180000
ONESA_MAX_TOKENS=1200

# For ONESA_PROVIDER=ollama
# ONESA_OLLAMA_URL=http://127.0.0.1:11434

# For ONESA_PROVIDER=openai_compatible
# ONESA_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# ONESA_AI_API_KEY=YOUR_GEMINI_API_KEY
# Gemini native TTS route (used by /api/tts and /api/speech action=tts)
# ONESA_GEMINI_TTS_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# ONESA_GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# ONESA_GEMINI_TTS_RESPONSE_FORMAT=wav

# Optional system instruction override
# ONESA_SYSTEM_PROMPT=You are Onesa AI...
# Set to true to use mock AI responses (skips real API calls — useful for UI dev/testing)
# ONESA_MOCK_MODE=false

# Groq (STT + LLM fallback)
# GROQ_API_KEY=gsk_...
# Optional base URL override (defaults to https://api.groq.com/openai/v1)
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# Whisper STT model (default: whisper-large-v3-turbo)
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# LLM model for /api/speech action=llm (default: llama3-8b-8192)
# GROQ_MODEL=llama3-8b-8192

# ElevenLabs (TTS)
# ELEVENLABS_API_KEY=sk_...
# Output format (default: mp3_44100_128)
# ONESA_ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Comma-separated admin emails (required for /admin access)
# ADMIN_EMAILS=admin@example.com,owner@example.com

# Oracle / GitHub Actions healthcheck alerts
# HEALTHCHECK_ALERT_TO=alerts@your-app-domain.com
# HEALTHCHECK_ALERT_FROM=no-reply@your-app-domain.com
# HEALTHCHECK_SMTP_SERVER=smtp.your-provider.com
# HEALTHCHECK_SMTP_PORT=587
# HEALTHCHECK_SMTP_USERNAME=your_smtp_username
# HEALTHCHECK_SMTP_PASSWORD=your_smtp_password

# Authentication (server-side only)
JWT_SECRET=replace_with_long_random_secret
# JWT access token TTL in seconds
JWT_EXPIRES_IN_SECONDS=3600

# Optional operator-approved Nominatim-compatible HTTPS place-search endpoint.
# Default: https://nominatim.openstreetmap.org/search (cached explicit searches,
# no autocomplete; shared one-request-per-1.1-seconds single-process gate).
# WEATHER_GEOCODER_URL=https://your-approved-geocoder.example/search

# Optional absolute directory of static files. Omit for an API-only server.
# STATIC_DIR=/srv/static
