generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              BigInt                   @id @default(autoincrement()) @db.BigInt
  email           String                   @db.VarChar(255)
  fullName        String                   @map("full_name") @db.VarChar(255)
  kycVerified     Boolean                  @default(false) @map("kyc_verified")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.DateTime(0)
  remittances     RemittanceTransaction[]
  airtimeTopups   AirtimeTransaction[]

  @@map("users")
}

model RemittanceTransaction {
  id                BigInt              @id @default(autoincrement()) @db.BigInt
  userId            BigInt              @map("user_id") @db.BigInt
  recipientName     String              @map("recipient_name") @db.VarChar(255)
  recipientType     RecipientType       @map("recipient_type")
  provider          String              @db.VarChar(100)
  payoutChannel     String?             @map("payout_channel") @db.VarChar(100)
  amountSent        Decimal             @map("amount_sent") @db.Decimal(12, 2)
  amountReceived    Decimal?            @map("amount_received") @db.Decimal(12, 2)
  currencyFrom      String              @map("currency_from") @db.VarChar(10)
  currencyTo        String              @map("currency_to") @db.VarChar(10)
  exchangeRate      Decimal?            @map("exchange_rate") @db.Decimal(12, 6)
  status            RemittanceStatus    @default(pending)
  terrapayReference String?             @map("terrapay_reference") @db.VarChar(255)
  idempotencyKey    String?             @map("idempotency_key") @db.VarChar(255)
  createdAt         DateTime            @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.DateTime(0)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId], map: "idx_remittance_user")
  @@index([status], map: "idx_remittance_status")
  @@map("remittance_transactions")
}

model AirtimeTransaction {
  id                BigInt          @id @default(autoincrement()) @db.BigInt
  userId            BigInt          @map("user_id") @db.BigInt
  phoneNumber       String          @map("phone_number") @db.VarChar(20)
  operatorId        String?         @map("operator_id") @db.VarChar(100)
  amount            Decimal         @db.Decimal(10, 2)
  currency          String?         @db.VarChar(10)
  reloadlyReference String?         @map("reloadly_reference") @db.VarChar(255)
  status            AirtimeStatus   @default(pending)
  createdAt         DateTime        @default(now()) @map("created_at") @db.DateTime(0)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId], map: "idx_airtime_user")
  @@map("airtime_transactions")
}

enum RecipientType {
  mobile_money
  cash_pickup
  visa_card
}

enum RemittanceStatus {
  pending
  processing
  completed
  failed
}

enum AirtimeStatus {
  pending
  completed
  failed
}
