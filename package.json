{
  "name": "du-platform",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "./scripts/dev-all.sh",
    "dev:fast": "./scripts/dev-all.sh --fast",
    "dev:web": "vite --config du-platform-frontend/vite.config.ts --host",
    "dev:server": "node --watch --env-file=.env --import tsx du-platform-backend/server.ts",
    "dev:all": "./scripts/dev-all.sh",
    "prepare": "pnpm hooks:install",
    "hooks:install": "sh -c 'if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then git config core.hooksPath .githooks; chmod +x .githooks/pre-commit; else echo \"[hooks:install] Not a git worktree; skipping.\"; fi'",
    "build": "pnpm build:frontend && pnpm build:backend",
    "start": "NODE_ENV=production node dist/server.js",
    "preview": "vite preview --config du-platform-frontend/vite.config.ts --host",
    "check": "pnpm check:frontend && pnpm check:backend",
    "guardrails:vite": "node scripts/guardrails/check-vite-guardrails.mjs",
    "guardrails:deploy": "node scripts/guardrails/check-deploy-guardrails.mjs",
    "guardrails:locales": "node scripts/guardrails/check-locales-shape.mjs",
    "guardrails": "pnpm guardrails:vite && pnpm guardrails:deploy && pnpm guardrails:locales",
    "sitemap:generate": "node --import tsx scripts/generate-sitemap.mjs",
    "test:e2e:onesa": "bash scripts/tests/e2e-onesa.sh",
    "test:e2e:onesa:bubble": "node scripts/tests/e2e-onesa-bubble-recover.mjs",
    "test:e2e:onesa:chat": "node scripts/tests/e2e-onesa-chat.mjs",
    "test:e2e:onesa:runtime": "node --import tsx scripts/tests/e2e-onesa-runtime.mjs",
    "test:modules": "vitest run --config du-platform-frontend/vite.config.ts --root . --dir du-platform-backend/modules",
    "format": "prettier --write .",
    "translations:sync": "python3 scripts/sync_translations.py --mode sync",
    "translations:sync:todo": "python3 scripts/sync_translations.py --mode sync --mark-missing",
    "translations:check:keys": "python3 scripts/sync_translations.py --mode check",
    "translations:check": "python3 scripts/sync_translations.py --mode check --require-translated --allow-same-keys-file scripts/translation_allow_same_keys.txt",
    "build:frontend": "vite build --config du-platform-frontend/vite.config.ts && node --import tsx scripts/build-route-documents.mjs && pnpm check:deployment-size",
    "build:backend": "esbuild du-platform-backend/server.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "check:frontend": "tsc --noEmit -p du-platform-frontend/tsconfig.json",
    "check:backend": "tsc --noEmit -p du-platform-backend/tsconfig.json",
    "format:check": "prettier --check .",
    "test:frontend": "vitest run --config du-platform-frontend/vite.config.ts --root . --dir du-platform-frontend/src && node --test scripts/tests/frontend-api-origin.test.mjs scripts/tests/deployment-size.test.mjs",
    "check:deployment-size": "node scripts/check-deployment-size.mjs",
    "test": "pnpm test:modules && pnpm test:frontend",
    "test:seo": "node --import tsx scripts/tests/seo-build.mjs",
    "test:seo:live": "node scripts/tests/seo-live.mjs",
    "test:e2e:offline": "node scripts/tests/e2e-offline-services.mjs",
    "test:e2e:navigation": "node scripts/tests/e2e-navigation.mjs",
    "test:e2e:shop": "node --import tsx scripts/tests/e2e-shop.mjs",
    "test:e2e:newsletter": "node scripts/tests/e2e-newsletter.mjs",
    "test:e2e:discovery": "node scripts/tests/e2e-discovery.mjs",
    "test:e2e:vr:music": "node scripts/tests/e2e-vr-music.mjs",
    "test:e2e:shop:integrated": "node --import tsx scripts/tests/e2e-shop-integrated.mjs",
    "test:deploy": "node --test scripts/tests/oracle-deploy.test.mjs && PYTHONDONTWRITEBYTECODE=1 python3 scripts/tests/oracle-release-worker.test.py && node --test scripts/tests/pilot-deploy.test.mjs",
    "test:e2e:shop:admin": "node scripts/tests/e2e-shop-admin.mjs",
    "test:e2e:pilot": "node scripts/tests/e2e-pilot.mjs",
    "test:e2e:pilot:layout": "node --import tsx scripts/tests/e2e-pilot-layout.mjs",
    "test:e2e:prelaunch": "node --import tsx scripts/tests/e2e-prelaunch.mjs",
    "test:recovery:custody": "node scripts/tests/recovery-custody.mjs",
    "test:recovery:application": "node scripts/tests/restored-application.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/xr": "^6.6.29",
    "@types/three": "^0.183.1",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "express": "^4.22.3",
    "framer-motion": "^12.23.22",
    "i18next": "^25.8.4",
    "lucide-react": "^0.453.0",
    "mysql2": "^3.24.5",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-globe.gl": "^2.37.0",
    "react-i18next": "^16.5.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "three": "^0.183.1",
    "wouter": "^3.3.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@builder.io/vite-plugin-jsx-loc": "^0.1.1",
    "@tailwindcss/vite": "^4.1.3",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "playwright": "^1.58.2",
    "pnpm": "^10.15.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "terser": "^5.46.0",
    "tsx": "^4.19.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.6.3",
    "vite": "^7.1.7",
    "vite-plugin-html": "^3.2.2",
    "vitest": "^2.1.4"
  },
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "pnpm": {
    "patchedDependencies": {
      "wouter@3.7.1": "patches/wouter@3.7.1.patch",
      "@pmndrs/xr@6.6.29": "patches/@pmndrs__xr@6.6.29.patch"
    },
    "overrides": {
      "tailwindcss>nanoid": "3.3.18",
      "lodash@<4.18.0": "4.18.1",
      "lodash-es@<4.18.0": "4.18.1",
      "postcss@<8.5.18": "8.5.29",
      "mermaid@<11.16.1": "11.16.1",
      "fflate@>=0.8.0 <0.8.3": "0.8.3",
      "fflate@>=0.6.0 <0.6.11": "0.6.11",
      "mdast-util-to-hast@<13.2.1": "13.2.1",
      "body-parser@<1.20.9": "1.20.9"
    }
  }
}
