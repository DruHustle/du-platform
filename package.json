{
  "name": "du-platform",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "./scripts/dev-all.sh",
    "dev:fast": "./scripts/dev-all.sh --fast",
    "dev:web": "pnpm --dir du-platform-frontend dev",
    "dev:server": "pnpm --dir du-platform-backend dev",
    "dev:all": "./scripts/dev-all.sh",
    "prepare": "pnpm hooks:install",
    "hooks:install": "sh -c 'if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then git config core.hooksPath .githooks; chmod +x .githooks/pre-commit; else echo \"[hooks:install] Not a git worktree; skipping.\"; fi'",
    "build": "pnpm build:frontend && pnpm build:backend",
    "start": "pnpm --dir du-platform-backend start",
    "preview": "pnpm --dir du-platform-frontend preview",
    "check": "pnpm check:frontend && pnpm check:backend",
    "guardrails:vite": "pnpm --dir du-platform-frontend guardrails:vite",
    "guardrails:deploy": "node scripts/guardrails/check-deploy-guardrails.mjs",
    "guardrails:locales": "pnpm --dir du-platform-frontend guardrails:locales",
    "guardrails": "pnpm guardrails:independence && pnpm guardrails:vite && pnpm guardrails:deploy && pnpm guardrails:locales",
    "guardrails:independence": "node scripts/guardrails/check-independence.mjs",
    "sitemap:generate": "pnpm --dir du-platform-frontend sitemap:generate",
    "test:e2e:onesa": "bash scripts/tests/e2e-onesa.sh",
    "test:e2e:onesa:bubble": "node scripts/tests/e2e-onesa-bubble-recover.mjs",
    "test:e2e:onesa:chat": "node scripts/tests/e2e-onesa-chat.mjs",
    "test:e2e:onesa:runtime": "node --import tsx scripts/tests/e2e-onesa-runtime.mjs",
    "test:modules": "pnpm --dir du-platform-backend test",
    "format": "prettier --write .",
    "translations:sync": "pnpm --dir du-platform-frontend translations:sync",
    "translations:sync:todo": "pnpm --dir du-platform-frontend translations:sync:todo",
    "translations:check:keys": "pnpm --dir du-platform-frontend translations:check:keys",
    "translations:check": "pnpm --dir du-platform-frontend translations:check",
    "build:frontend": "pnpm --dir du-platform-frontend build",
    "build:backend": "pnpm --dir du-platform-backend build",
    "check:frontend": "pnpm --dir du-platform-frontend check",
    "check:backend": "pnpm --dir du-platform-backend check",
    "format:check": "prettier --check .",
    "test:frontend": "pnpm --dir du-platform-frontend test",
    "check:deployment-size": "pnpm --dir du-platform-frontend check:deployment-size",
    "test": "pnpm test:modules && pnpm test:frontend",
    "test:seo": "pnpm --dir du-platform-frontend test:seo",
    "test:seo:live": "pnpm --dir du-platform-frontend test:seo:live",
    "test:e2e:offline": "node scripts/tests/e2e-offline-services.mjs",
    "test:e2e:navigation": "node scripts/tests/e2e-navigation.mjs",
    "test:e2e:shop": "node --import tsx scripts/tests/e2e-shop.mjs",
    "test:e2e:newsletter": "node scripts/tests/e2e-newsletter.mjs",
    "test:e2e:transactional": "node --import tsx scripts/tests/e2e-transactional.mjs",
    "test:e2e:discovery": "node scripts/tests/e2e-discovery.mjs",
    "test:e2e:vr:music": "node scripts/tests/e2e-vr-music.mjs",
    "test:e2e:shop:integrated": "node --import tsx scripts/tests/e2e-shop-integrated.mjs",
    "test:deploy": "node --test scripts/tests/oracle-deploy.test.mjs && PYTHONDONTWRITEBYTECODE=1 python3 scripts/tests/oracle-release-worker.test.py && node --test scripts/tests/pilot-deploy.test.mjs scripts/tests/vercel-release.test.mjs",
    "test:e2e:shop:admin": "node scripts/tests/e2e-shop-admin.mjs",
    "test:e2e:pilot": "node scripts/tests/e2e-pilot.mjs",
    "test:e2e:pilot:layout": "node --import tsx scripts/tests/e2e-pilot-layout.mjs",
    "test:e2e:prelaunch": "node --import tsx scripts/tests/e2e-prelaunch.mjs",
    "test:recovery:custody": "node scripts/tests/recovery-custody.mjs",
    "test:recovery:application": "node scripts/tests/restored-application.mjs",
    "test:e2e:shop:followup": "node --import tsx scripts/tests/e2e-shop-followup.mjs",
    "test:backup:mac": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/tests/mac-backup-pull.test.py",
    "test:e2e:ui": "node --import tsx scripts/tests/e2e-ui-consistency.mjs",
    "test:e2e:travel": "node --import tsx scripts/tests/e2e-travel.mjs",
    "test:e2e:theme": "node --import tsx scripts/tests/e2e-theme.mjs",
    "test:e2e:weather": "node --import tsx scripts/tests/e2e-weather.mjs",
    "install:apps": "pnpm --dir du-platform-frontend install --frozen-lockfile && pnpm --dir du-platform-backend install --frozen-lockfile",
    "setup": "pnpm install --frozen-lockfile && pnpm install:apps"
  },
  "devDependencies": {
    "playwright": "^1.58.2",
    "pnpm": "^10.15.1",
    "prettier": "^3.6.2",
    "tsx": "^4.19.1",
    "typescript": "5.6.3",
    "express": "^4.22.3",
    "mysql2": "^3.24.5"
  },
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "pnpm": {
    "overrides": {
      "tailwindcss>nanoid": "3.3.18",
      "lodash@<4.18.0": "4.18.1",
      "lodash-es@<4.18.0": "4.18.1",
      "postcss@<8.5.18": "8.5.29",
      "mermaid@<11.16.1": "11.16.1",
      "fflate@>=0.8.0 <0.8.3": "0.8.3",
      "fflate@>=0.6.0 <0.6.11": "0.6.11",
      "mdast-util-to-hast@<13.2.1": "13.2.1",
      "body-parser@<1.20.9": "1.20.9",
      "qs@<6.16.1": "6.16.1"
    }
  },
  "private": true
}
